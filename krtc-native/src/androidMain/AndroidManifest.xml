<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Screen capture (AndroidScreenCapture) runs in a foreground service of type mediaProjection (Android 10+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <application>
        <service android:name="krtc.native.ScreenCaptureService" android:exported="false" android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
